{
  "model": "claude-sonnet-4-6",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(curl *)", "Bash(python *)", "Bash(pytest *)", "Bash(pip install *)",
      "Bash(find *)", "Bash(grep *)", "Bash(cat *)", "Bash(ls *)",
      "Bash(uvicorn *)", "Bash(git status)", "Bash(git diff *)",
      "Bash(git add *)", "Bash(git commit *)"
    ],
    "deny": ["Bash(rm -rf *)", "Bash(git push *)", "Read(.env)", "Read(**/.env*)"]
  }
}
