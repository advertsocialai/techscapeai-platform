# ────────────────────────────────────────────────
# TechScape AI — Backend Environment Variables
# Copy this file to .env and fill in the values.
# ────────────────────────────────────────────────

# Application
APP_NAME=TechScape AI API
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# CORS — Frontend URL
FRONTEND_URL=https://techscapeai.com
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=["https://techscapeai.com","https://www.techscapeai.com"]

# ── Supabase (do NOT change existing values) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Email (optional — for contact form notifications) ──
SENDGRID_API_KEY=
RESEND_API_KEY=
NOTIFICATION_EMAIL=hello@techscapeai.com
FROM_EMAIL=noreply@techscapeai.com

# ── Auth ──
JWT_SECRET=change-me-in-prod
JWT_REFRESH_SECRET=change-me-too-in-prod
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7
FERNET_KEY=

# ── GoGaga Voice — Plivo (+91 domestic, DLT-registered) ──
# Twilio is NOT used for India voice (legal restriction). Plivo only.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=
PLIVO_BUSINESS_ID=         # UUID of the business that owns this Plivo number
PUBLIC_BASE_URL=            # ngrok HTTPS URL in dev (e.g. https://abc.ngrok-free.app)

# ── GoGaga Voice — STT (Speech-to-Text) ──
DEEPGRAM_API_KEY=           # English / Hindi (Nova-2, default engine)
SARVAM_API_KEY=             # Telugu / code-mix (Saarika v2 STT + Bulbul TTS)

# ── GoGaga Voice — TTS (Text-to-Speech) ──
ELEVENLABS_API_KEY=         # English / Hindi (Flash model, low-latency streaming)

# ── GoGaga AI — Claude (voice persona + tool-calling) ──
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:5173
RATE_LIMIT_CONTACT=5        # requests per minute per IP
RATE_LIMIT_NEWSLETTER=3
REDIS_URL=                  # e.g. redis://localhost:6379/0
SENDGRID_WEBHOOK_PUBLIC_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_AUTH_TOKEN=   # falls back to TWILIO_AUTH_TOKEN if empty
WAPI_API_TOKEN=
WAPI_BASE_URL=https://api.wapi.ai
WAPI_WEBHOOK_SECRET=

# ── Payments (Razorpay) — stub:// links until set ─────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── WhatsApp (Meta Cloud API) — writes to whatsapp_outbox until set ───────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Observability alerting (wave-2) — defaults are sane; opt-in loop ──────
OBSERVABILITY_ALERTS=false
ALERT_CHECK_INTERVAL_SECONDS=60
ALERT_COOLDOWN_SECONDS=900
ALERT_ERROR_RATE_PER_MIN=10
ALERT_PAYMENT_SIG_FAILURES=5
ALERT_VOICE_TURN_BUDGET_MS=2500
ALERT_VOICE_TURN_MIN_SAMPLES=5

# ── Payments (Razorpay) — stub:// links until set ─────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── WhatsApp (Meta Cloud API) — writes to whatsapp_outbox until set ───────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Observability alerting (wave-2) — defaults are sane; opt-in loop ──────
OBSERVABILITY_ALERTS=false
ALERT_CHECK_INTERVAL_SECONDS=60
ALERT_COOLDOWN_SECONDS=900
ALERT_ERROR_RATE_PER_MIN=10
ALERT_PAYMENT_SIG_FAILURES=5
ALERT_VOICE_TURN_BUDGET_MS=2500
ALERT_VOICE_TURN_MIN_SAMPLES=5
