# customer-app environment
#
# Both are OPTIONAL in local dev: vite.config.ts proxies /api to
# http://localhost:8000, so the defaults below are what the app uses when these
# are unset. Set them for a deployed build, where there is no dev proxy.

# Agency/auth surface — login, OTP, registration.
VITE_API_URL=/api/techscape/v1

# Traveller surface — /me/trip, /me/payments, /me/messages.
# A DIFFERENT base path from VITE_API_URL on purpose: these endpoints take a
# traveller token, and the backend refuses each token family on the other's
# routes. Pointing both at one base would not merge them, it would just 401.
VITE_TRAVEL_API_URL=/api/travel/v1/me
