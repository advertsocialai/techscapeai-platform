# ────────────────────────────────────────────────
# TechScape AI — Backend Environment Variables
# Copy this file to .env (inside api/, since run.sh loads .env relative
# to its own cwd) and fill in the values.
#
# Kept in sync with api/app/core/config.py's Settings fields — every
# field in that class should have a line here (2026-08-07 sprint: this
# file had drifted badly out of date, missing JWT/GoGaga voice/Redis
# vars entirely; resynced against config.py + the newer root
# .env.example added in the same commit that added Phase 3 voice code).
# ────────────────────────────────────────────────

# Application
APP_NAME=TechScape AI API
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# CORS — Frontend URL
FRONTEND_URL=https://techscapeai.com
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=["https://techscapeai.com","https://www.techscapeai.com"]

# ── Supabase (do NOT change existing values) ──
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Email (optional — for contact form notifications) ──
SENDGRID_API_KEY=
RESEND_API_KEY=
NOTIFICATION_EMAIL=hello@techscapeai.com
FROM_EMAIL=noreply@techscapeai.com

# ── TechScape Workflow Platform — channel providers ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
WAPI_API_TOKEN=
WAPI_BASE_URL=https://api.wapi.ai

# ── TechScape AI agent (Claude) — also powers GoGaga's post-call/suggestion services ──
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6

# ── GoGaga Voice — Plivo (+91 domestic, DLT-registered) ──
# Twilio is NOT used for India voice (legal restriction). Plivo only.
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
PLIVO_PHONE_NUMBER=
PLIVO_BUSINESS_ID=          # legacy single-tenant fallback; business_phone_numbers table (P3 T7) is the real routing path
PUBLIC_BASE_URL=            # ngrok HTTPS URL in dev (e.g. https://abc.ngrok-free.app)

# ── GoGaga Voice — STT (Speech-to-Text) ──
DEEPGRAM_API_KEY=           # English / Hindi (Nova-2, default engine)
SARVAM_API_KEY=             # Telugu / code-mix (Saarika v2 STT + Bulbul TTS)

# ── GoGaga Voice — TTS (Text-to-Speech) ──
ELEVENLABS_API_KEY=         # English / Hindi (Flash model, low-latency streaming)

# ── Auth ──
JWT_SECRET=change-me-in-prod
JWT_REFRESH_SECRET=change-me-too-in-prod
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=7

# Symmetric key (urlsafe base64, 32-byte) for ts_api_integrations.credentials_encrypted
# If empty a key is derived from JWT_SECRET (DEV only).
FERNET_KEY=

# ── OAuth2 (optional) ──
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:5173

# ── Webhooks: signing secrets for inbound providers ──
TWILIO_WEBHOOK_AUTH_TOKEN=   # falls back to TWILIO_AUTH_TOKEN if empty
SENDGRID_WEBHOOK_PUBLIC_KEY=
WAPI_WEBHOOK_SECRET=

# ── Phase 3: Redis (T8 — call_feed pub/sub + JTI blacklist) ──
# Falls back gracefully to in-process implementations if not set.
REDIS_URL=                  # e.g. redis://localhost:6379/0

# ── Rate limiting ──
RATE_LIMIT_CONTACT=5        # requests per minute per IP
RATE_LIMIT_NEWSLETTER=3

# ── Payments (Razorpay) — stub:// links until set ─────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── WhatsApp (Meta Cloud API) — writes to whatsapp_outbox until set ───────
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Observability alerting (wave-2) — defaults are sane; opt-in loop ──────
OBSERVABILITY_ALERTS=false
ALERT_CHECK_INTERVAL_SECONDS=60
ALERT_COOLDOWN_SECONDS=900
ALERT_ERROR_RATE_PER_MIN=10
ALERT_PAYMENT_SIG_FAILURES=5
ALERT_VOICE_TURN_BUDGET_MS=2500
ALERT_VOICE_TURN_MIN_SAMPLES=5
